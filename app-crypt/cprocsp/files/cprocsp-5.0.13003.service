[Unit]
Description=CryptoPro CSP services
Documentation=https://cryptopro.ru/products/csp
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/cprocsp/libexec/cprocsp-services.sh start
ExecStop=/opt/cprocsp/libexec/cprocsp-services.sh stop
ExecReload=/opt/cprocsp/libexec/cprocsp-services.sh restart

[Install]
WantedBy=multi-user.target
